# .env.example — PLACEHOLDER NAMES ONLY. Never put real values in this file.
#
# Copy to a local `.env` (git-ignored) and fill in values only once each
# service has been approved by the business owner (CLAUDE.md Rule 4).
# Nothing here is a live account or credential. Updated 2026-10-31.

# =====================================================================
# 1. USED BY THE WEBSITE TODAY
# =====================================================================

# The site's own public address, e.g. https://www.timesestates.co.uk
# REQUIRED AT DEPLOYMENT: used for canonical links, the sitemap, sharing
# previews and search-engine data. Defaults to http://localhost:3000.
NEXT_PUBLIC_SITE_URL=

# Staging copy only: "true" shows internal content notes for owner
# review. Never set on the public site.
NEXT_PUBLIC_SHOW_CONTENT_NOTES=

# Signs the staff sign-in cookie. At least 32 random characters. Leave
# empty in development (a random one is made at each start). Never
# commit a real value. Only meaningful once real staff sign-in exists.
ADMIN_SESSION_SECRET=

# Set automatically by the hosting platform ("production" when live).
NODE_ENV=development

# =====================================================================
# 2. RESERVED FOR SERVICES NOT YET APPROVED — NOT READ BY THE CODE
# Each needs owner approval (cost, provider, data terms) before use.
# See INTEGRATIONS.md for the options.
# =====================================================================

# Database (leads, valuations, audit log must survive restarts)
DATABASE_URL=

# Real staff sign-in with two-step verification
AUTH_SECRET=
AUTH_URL=

# Email delivery (staff alerts, confirmations, property alerts)
EMAIL_FROM_ADDRESS=
EMAIL_PROVIDER_API_KEY=

# Private file storage + malware scanning (repair photos)
FILE_STORAGE_BUCKET=
FILE_STORAGE_ACCESS_KEY=
FILE_STORAGE_SECRET_KEY=

# CRM / property feed
CRM_API_URL=
CRM_API_KEY=
PROPERTY_FEED_API_KEY=

# AI provider for the assistant (optional; demonstration mode needs none)
AI_PROVIDER_API_KEY=

# Maps / address lookup (only if a map is approved)
MAPS_API_KEY=
ADDRESS_LOOKUP_API_KEY=

# Analytics (needs a cookie-consent banner first)
ANALYTICS_ID=

# Error monitoring
MONITORING_DSN=
