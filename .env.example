# .env.example — PLACEHOLDER NAMES ONLY. Never put real values in this file.
# Copy this to a local .env (which is git-ignored) and fill in real values
# only once each integration has been explicitly approved by the business
# owner. Nothing in this file represents a live account or credential.

# --- Application ---
NEXT_PUBLIC_SITE_URL=
NODE_ENV=development

# --- Database (proposed — subject to Day 2 confirmation) ---
DATABASE_URL=

# --- Authentication (if an admin/staff login area is built) ---
AUTH_SECRET=
AUTH_URL=

# --- Content management system (provider TBC) ---
CMS_API_URL=
CMS_API_TOKEN=

# --- Email delivery (provider TBC — e.g. transactional email service) ---
EMAIL_FROM_ADDRESS=
EMAIL_PROVIDER_API_KEY=

# --- CRM / property feed integration (provider TBC) ---
CRM_API_URL=
CRM_API_KEY=
PROPERTY_FEED_API_KEY=

# --- AI assistance (controlled AI assistant feature) ---
AI_PROVIDER_API_KEY=
AI_ASSISTANT_MODE=controlled

# --- Spam / bot protection on public forms ---
CAPTCHA_SITE_KEY=
CAPTCHA_SECRET_KEY=

# --- Maps / address lookup (if used for property locations) ---
MAPS_API_KEY=
ADDRESS_LOOKUP_API_KEY=

# --- Analytics (provider TBC) ---
ANALYTICS_ID=

# --- Error monitoring (provider TBC) ---
MONITORING_DSN=

# --- Deployment / hosting (provider TBC) ---
DEPLOYMENT_PROJECT_ID=
DEPLOYMENT_API_TOKEN=
