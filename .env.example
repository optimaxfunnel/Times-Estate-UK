# .env.example — PLACEHOLDER NAMES ONLY. Never put real values in this file.
#
# Copy to a local `.env` (git-ignored) and fill in values only once each
# service has been approved by the business owner (CLAUDE.md Rule 4).
# Nothing here is a live account or credential. Updated 2026-10-31.

# =====================================================================
# 1. USED BY THE WEBSITE TODAY
# =====================================================================

# The site's own public address, e.g. https://www.timesestates.co.uk
# REQUIRED AT DEPLOYMENT: used for canonical links, the sitemap, sharing
# previews and search-engine data. Defaults to http://localhost:3000.
NEXT_PUBLIC_SITE_URL=

# Staging copy only: "true" shows internal content notes for owner
# review. Never set on the public site.
NEXT_PUBLIC_SHOW_CONTENT_NOTES=

# Signs the staff sign-in cookie. At least 32 random characters. Leave
# empty in development (a random one is made at each start). Never
# commit a real value. Only meaningful once real staff sign-in exists.
ADMIN_SESSION_SECRET=

# Set automatically by the hosting platform ("production" when live).
NODE_ENV=development

# =====================================================================
# 2. RESERVED FOR SERVICES NOT YET APPROVED — NOT READ BY THE CODE
# Each needs owner approval (cost, provider, data terms) before use.
# See INTEGRATIONS.md for the options.
# =====================================================================

# (DATABASE_URL moved to section 3 below — it is now read by the code.)

# Real staff sign-in with two-step verification
AUTH_SECRET=
AUTH_URL=

# Email delivery (staff alerts, confirmations, property alerts)
EMAIL_FROM_ADDRESS=
EMAIL_PROVIDER_API_KEY=

# Private file storage + malware scanning (repair photos)
FILE_STORAGE_BUCKET=
FILE_STORAGE_ACCESS_KEY=
FILE_STORAGE_SECRET_KEY=

# CRM / property feed
CRM_API_URL=
CRM_API_KEY=
PROPERTY_FEED_API_KEY=

# AI provider for the assistant (optional; demonstration mode needs none)
AI_PROVIDER_API_KEY=

# Maps / address lookup (only if a map is approved)
MAPS_API_KEY=
ADDRESS_LOOKUP_API_KEY=

# Analytics (needs a cookie-consent banner first)
ANALYTICS_ID=

# Error monitoring
MONITORING_DSN=

# =====================================================================
# 3. DATABASE — read by the code since 2026-11-09
# Provider chosen by the owner: Supabase; project in Ireland (eu-west-1),
# owner decision 2026-11-09 (DECISIONS.md).
# Put the real value in web/.env (git-ignored) on a computer, or in the
# hosting provider's settings on the live site. Never in chat or git.
# =====================================================================

# Supabase → Project → Connect → "Transaction pooler" connection string
# (port 6543), with the database password filled in. When EMPTY, the site
# uses a local PostgreSQL (PGlite) saved in web/.data/ — for this computer
# only, never for the live site.
DATABASE_URL=

# Sample (fabricated, clearly labelled) listings are loaded into an EMPTY
# properties table. Set to "false" once real listings replace them, so a
# cleared table is never refilled with sample data.
SEED_DEMO_PROPERTIES=

# Optional, local only: "memory" = nothing saved; or a folder for the
# local database instead of web/.data/pglite.
LOCAL_DB=
LOCAL_DB_DIR=

# =====================================================================
# 4. STAFF SIGN-IN (Supabase Auth) — read by the code since 2026-11-09
# Supabase → Connect → "App Frameworks" (Next.js). Both values are public
# by design and are used only on the website's server. When EMPTY on a
# development computer, a test-only sign-in is offered instead; on a
# production build without them, the admin area stays closed.
# =====================================================================
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
